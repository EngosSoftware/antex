.note These task definitions require TaskCommander.
      Install it using cargo:
      `cargo install task-commander`

.vars
  .RUST_TOOLCHAIN +1.85.0

.tasks

  .all
    .task clean
    .task fmt
    .task build
    .task clippy
    .task pedantic
    .task test
    .task doc
    .task cov

  .build
    .desc Builds in debug mode
    .cmd cargo {{RUST_TOOLCHAIN}} build

  .clean
    .desc Cleans all targets
    .cmd cargo {{RUST_TOOLCHAIN}} clean
    .cmd rm -rf manual/book

  .clippy
    .desc Runs clippy for all targets
    .cmd cargo {{RUST_TOOLCHAIN}} clippy --all-targets -- -D warnings

  .cov
    .desc Generates code coverage report in text format
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .task cov-extra
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --no-clean

  .cov-html
    .desc Generates code coverage report in HTML format
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .task cov-extra
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --no-clean --html

  .cov-html-open
    .desc Generates code coverage report in HTML and opens in browser
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .task cov-extra
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --no-clean --html --open

  .cov-badge
    .desc Generates the detailed code coverage badge
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .task cov-extra
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --no-clean --json --summary-only | coverio -c --tag cov-badge

  .cov-extra
    .desc Executes additional test with output redirected to other process
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov test text_default_should_work --no-report | cat

  .doc
    .desc Generates documentation
    .cmd cargo {{RUST_TOOLCHAIN}} doc --document-private-items

  .doc-open
    .desc Generates documentation and opens in browser
    .cmd cargo {{RUST_TOOLCHAIN}} doc --open --document-private-items

  .fmt
    .desc Runs code formatter
    .cmd cargo {{RUST_TOOLCHAIN}} fmt

  .manual
    .desc Builds the manual from its markdown files
    .cmd mdbook build
      .dir manual

  .pedantic
    .desc Runs pedantic linter
    .cmd cargo {{RUST_TOOLCHAIN}} clippy --all-targets -- -D warnings -W clippy::pedantic -W clippy::nursery -W clippy::cargo

  .readme
    .desc Regenerates README.md file
    .cmd magg readme
    .task cov-badge

  .serve
    .desc Serves the manual locally and rebuilds on changes
    .cmd mdbook serve
      .dir manual

  .test
    .desc Runs tests in debug mode
    .cmd cargo {{RUST_TOOLCHAIN}} test

  .testn
    .desc Runs tests in debug mode
    .cmd cargo {{RUST_TOOLCHAIN}} nextest run
